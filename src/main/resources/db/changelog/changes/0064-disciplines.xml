<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0064-disciplines" author="raftscore">
        <createTable tableName="disciplines">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="competition_id" type="BIGINT"><constraints nullable="false" foreignKeyName="disciplines_competition_fk" references="competitions(id)"/></column>
            <column name="name" type="TEXT"><constraints nullable="false"/></column>
            <column name="type" type="TEXT"><constraints nullable="false"/></column>
            <column name="display_order" type="INTEGER"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE disciplines ADD CONSTRAINT disciplines_name_nonblank CHECK (name ~ '[^[:space:]]')</sql>
        <sql>ALTER TABLE disciplines ADD CONSTRAINT disciplines_type_valid CHECK (type IN ('SPRINT', 'PARALLEL_SPRINT', 'SLALOM', 'LONG_RACE'))</sql>
        <sql>ALTER TABLE disciplines ADD CONSTRAINT disciplines_display_order_nonnegative CHECK (display_order &gt;= 0)</sql>
    </changeSet>
</databaseChangeLog>
