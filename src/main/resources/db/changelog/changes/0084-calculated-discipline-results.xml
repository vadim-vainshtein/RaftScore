<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0084-calculated-discipline-results" author="raftscore">
        <createTable tableName="calculated_discipline_results">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="discipline_id" type="BIGINT"><constraints nullable="false" foreignKeyName="calculated_results_discipline_fk" references="disciplines(id)"/></column>
            <column name="crew_entry_id" type="BIGINT"><constraints nullable="false" foreignKeyName="calculated_results_crew_fk" references="crew_entries(id)"/></column>
            <column name="place" type="INTEGER"/>
            <column name="total_centiseconds" type="BIGINT"/>
            <column name="summary" type="VARCHAR(1000)"/>
            <column name="status" type="TEXT"><constraints nullable="false"/></column>
            <column name="points" type="INTEGER"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="calculated_discipline_results" columnNames="discipline_id, crew_entry_id" constraintName="calculated_results_identity_unique"/>
        <sql>ALTER TABLE calculated_discipline_results ADD CONSTRAINT calculated_results_place_positive CHECK (place &gt; 0)</sql>
        <sql>ALTER TABLE calculated_discipline_results ADD CONSTRAINT calculated_results_time_nonnegative CHECK (total_centiseconds &gt;= 0)</sql>
        <sql>ALTER TABLE calculated_discipline_results ADD CONSTRAINT calculated_results_points_nonnegative CHECK (points &gt;= 0)</sql>
        <sql>ALTER TABLE calculated_discipline_results ADD CONSTRAINT calculated_results_status_valid CHECK (status IN ('FINISHED', 'DNS', 'DNF', 'DSQ_ATTEMPT', 'DSQ_DISCIPLINE', 'DSQ_COMPETITION'))</sql>
    </changeSet>
</databaseChangeLog>
