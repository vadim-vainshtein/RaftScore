<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0034-category-templates" author="raftscore">
        <createTable tableName="category_templates">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="class_label" type="TEXT"><constraints nullable="false"/></column>
            <column name="scoring_group_label" type="TEXT"><constraints nullable="false"/></column>
            <column name="crew_size" type="INTEGER"><constraints nullable="false"/></column>
            <column name="archived" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE category_templates ADD CONSTRAINT category_templates_crew_size_positive CHECK (crew_size &gt; 0)</sql>
    </changeSet>
</databaseChangeLog>
