<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0057-membership-category-uniqueness" author="raftscore">
        <preConditions onFail="HALT" onFailMessage="Cannot enforce participant uniqueness: duplicate memberships exist in a competition category">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM (SELECT c.competition_category_id, m.participant_id FROM crew_memberships m JOIN crew_entries c ON c.id = m.crew_entry_id GROUP BY c.competition_category_id, m.participant_id HAVING COUNT(*) &gt; 1) duplicates</sqlCheck>
        </preConditions>
        <addColumn tableName="crew_memberships">
            <column name="competition_category_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE crew_memberships m SET competition_category_id = c.competition_category_id FROM crew_entries c WHERE c.id = m.crew_entry_id</sql>
        <addNotNullConstraint tableName="crew_memberships" columnName="competition_category_id" columnDataType="BIGINT"/>
        <addUniqueConstraint tableName="crew_entries" columnNames="id, competition_category_id" constraintName="crew_entries_id_category_uk"/>
        <addForeignKeyConstraint baseTableName="crew_memberships" baseColumnNames="crew_entry_id, competition_category_id"
                                 referencedTableName="crew_entries" referencedColumnNames="id, competition_category_id"
                                 constraintName="crew_memberships_crew_category_fk"/>
        <addUniqueConstraint tableName="crew_memberships" columnNames="competition_category_id, participant_id" constraintName="crew_memberships_category_participant_uk"/>
    </changeSet>
</databaseChangeLog>
