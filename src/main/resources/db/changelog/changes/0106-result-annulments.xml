<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0106-result-annulments" author="raftscore">
        <createTable tableName="result_annulments">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="competition_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="discipline_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="category_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="crew_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="result_snapshot" type="TEXT"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(2000)"><constraints nullable="false"/></column>
            <column name="annulled_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="result_annulments" baseColumnNames="competition_id" referencedTableName="competitions" referencedColumnNames="id" constraintName="result_annulments_competition_fk"/>
        <addForeignKeyConstraint baseTableName="result_annulments" baseColumnNames="discipline_id" referencedTableName="disciplines" referencedColumnNames="id" constraintName="result_annulments_discipline_fk"/>
        <addForeignKeyConstraint baseTableName="result_annulments" baseColumnNames="category_id" referencedTableName="competition_categories" referencedColumnNames="id" constraintName="result_annulments_category_fk"/>
        <addForeignKeyConstraint baseTableName="result_annulments" baseColumnNames="crew_id" referencedTableName="crew_entries" referencedColumnNames="id" constraintName="result_annulments_crew_fk"/>
    </changeSet>
</databaseChangeLog>
