<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="0065-discipline-categories" author="raftscore">
        <!-- This pair identifies a participating discipline/category for future starts and results. -->
        <createTable tableName="discipline_categories">
            <column name="discipline_id" type="BIGINT"><constraints nullable="false" foreignKeyName="discipline_categories_discipline_fk" references="disciplines(id)"/></column>
            <column name="category_id" type="BIGINT"><constraints nullable="false" foreignKeyName="discipline_categories_category_fk" references="competition_categories(id)"/></column>
        </createTable>
        <addPrimaryKey tableName="discipline_categories" columnNames="discipline_id, category_id" constraintName="discipline_categories_pk"/>
    </changeSet>
</databaseChangeLog>
